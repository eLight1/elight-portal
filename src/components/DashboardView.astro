---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { PortalUser } from '../lib/auth';
import type { ServiceTicket } from '../lib/google-sheets';

interface Props {
  user: PortalUser;
  ticket?: ServiceTicket | null;
  ticketsCount?: number;
  preview?: boolean;
}

const { user, ticket = null, ticketsCount = ticket ? 1 : 0, preview = false } = Astro.props;
const firstName = user.name.split(' ')[0] || 'there';
const statusStep = ticket?.statusStep ?? 1;
const statusLabel = ticket?.status || ({ 1: 'Received', 2: 'In progress', 3: 'Resolution ready' } as const)[statusStep];
const statusSteps = [
  { step: 1, label: 'Received' },
  { step: 2, label: 'Assessment' },
  { step: 3, label: 'Resolution' }
];
const progressPercent = `${Math.round((statusStep / 3) * 100)}%`;

const metrics = [
  {
    label: 'Open requests',
    value: String(ticketsCount).padStart(2, '0'),
    detail: ticketsCount === 0 ? 'Ready when you are' : `${ticketsCount} active service ${ticketsCount === 1 ? 'ticket' : 'tickets'}`,
    icon: 'clipboard',
    tone: 'blue'
  },
  {
    label: 'Devices covered',
    value: preview ? '03' : '—',
    detail: preview ? 'All health checks current' : 'No device inventory linked',
    icon: 'laptop',
    tone: 'green'
  },
  {
    label: 'Next appointment',
    value: preview ? '04 Sep' : '—',
    detail: preview ? '09:30 · Remote session' : 'No appointment scheduled',
    icon: 'clock',
    tone: 'gold'
  }
];

const activity = preview
  ? [
      { date: 'Today, 08:42', title: 'Technician added a note to your laptop request', detail: 'We found one more performance check to run.', icon: 'message', color: 'blue' },
      { date: '28 Aug, 16:10', title: 'Health check report is ready', detail: 'Your device summary is available to review.', icon: 'check', color: 'green' },
      { date: '26 Aug, 11:05', title: 'Request received', detail: 'We will keep you updated at each step.', icon: 'clipboard', color: 'gold' }
    ]
  : ticket
    ? [{ date: ticket.updatedAt || 'Recently', title: `${ticket.serviceName} is active`, detail: `Current status: ${statusLabel}.`, icon: 'clipboard', color: 'blue' }]
    : [];

const services = [
  { label: 'Device Care', detail: 'Diagnosis, setup & repair', icon: 'laptop' },
  { label: 'Business IT', detail: 'Keep your team moving', icon: 'grid' },
  { label: 'Website & Automation', detail: 'Build a clearer digital presence', icon: 'arrowUp' },
  { label: 'Life Coaching', detail: 'Move forward with clarity', icon: 'sparkle' }
];
---

<BaseLayout title="Overview | E Light Services" activeNav="Overview" user={user}>
  {preview && (
    <div class="mb-6 flex flex-col gap-3 rounded-2xl border border-[#b8dff0] bg-[#effaff] px-4 py-3 text-sm text-[#285978] sm:flex-row sm:items-center sm:justify-between sm:px-5">
      <div class="flex items-start gap-3">
        <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[#d6f2ff] text-[#1267a8]"><Icon name="sparkle" size={15} /></span>
        <p><strong class="font-bold text-[#123e61]">Preview mode.</strong> This is sample dashboard data; live access is protected.</p>
      </div>
      <a href="/login" class="shrink-0 font-bold text-[#1267a8] hover:text-[#0a416b]">Sign in to continue <span aria-hidden="true">→</span></a>
    </div>
  )}
  <div class="space-y-8">
    <section class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
      <div>
        <p class="eyebrow">Saturday, 29 August 2026 <span class="mx-1.5 text-[#b3c2d0]">·</span> Accra</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-[#102845] sm:text-4xl">Good morning, {firstName}.</h1>
        <p class="mt-2 max-w-xl text-sm leading-6 text-[#607a95]">Here is the clearest view of your services, requests and next steps.</p>
      </div>
      <a href="/requests/new" class="inline-flex w-fit items-center justify-center gap-2 rounded-xl bg-[#1267a8] px-4 py-3 text-sm font-bold text-white shadow-[0_8px_20px_rgba(18,103,168,0.18)] transition hover:-translate-y-0.5 hover:bg-[#0e568e] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1267a8] focus-visible:ring-offset-2">
        <Icon name="plus" size={18} />
        New service request
      </a>
    </section>

    {ticket ? (
      <section class="grid gap-5 xl:grid-cols-[minmax(0,1.7fr)_minmax(300px,0.9fr)]" aria-label="Current request and next step">
        <article class="relative isolate overflow-hidden rounded-2xl bg-[#0a2850] p-6 text-white shadow-[0_18px_40px_rgba(10,40,80,0.12)] sm:p-8">
          <div class="pointer-events-none absolute -right-16 -top-28 -z-10 h-72 w-72 rounded-full bg-[#1b6da9]/35 blur-3xl"></div>
          <div class="pointer-events-none absolute bottom-[-7rem] right-24 -z-10 h-56 w-56 rounded-full bg-[#f3bf58]/15 blur-3xl"></div>
          <div class="flex flex-col justify-between gap-8 md:flex-row md:items-start">
            <div class="max-w-xl">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-[#f3bf58] px-2.5 py-1 text-[0.65rem] font-bold tracking-[0.08em] text-[#102845]">{ticket.ticketId}</span>
                <span class="text-[0.65rem] font-bold uppercase tracking-[0.12em] text-[#a9c3df]">Active request</span>
              </div>
              <h2 class="mt-5 max-w-md text-2xl font-semibold tracking-[-0.03em] sm:text-[1.75rem]">{ticket.serviceName}</h2>
              <p class="mt-3 max-w-lg text-sm leading-6 text-[#b9cee3]">{ticket.description || 'We are reviewing your request and will keep you informed at each clear next step.'}</p>
            </div>
            <span class="flex w-fit items-center gap-2 rounded-full border border-[#70d5f2]/30 bg-[#12416f] px-3 py-2 text-xs font-semibold text-[#b7efff]">
              <span class="h-2 w-2 rounded-full bg-[#6fe0ff] shadow-[0_0_0_3px_rgba(111,224,255,0.12)]"></span>
              {statusLabel}
            </span>
          </div>

          <div class="mt-9 border-t border-white/15 pt-5">
            <div class="mb-3 flex items-center justify-between text-xs">
              <span class="font-semibold text-[#d9e8f5]">Request progress</span>
              <span class="font-bold text-[#78d9ff]">{statusStep} of 3 steps</span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-white/15" role="progressbar" aria-label="Request progress" aria-valuemin="1" aria-valuemax="3" aria-valuenow={statusStep}>
              <div class="h-full rounded-full bg-[#73d7ff] transition-[width] duration-500" style={`width: ${progressPercent}`}></div>
            </div>
            <div class="mt-5 grid grid-cols-3 gap-3 text-xs">
              {statusSteps.map((item) => {
                const complete = statusStep > item.step;
                const current = statusStep === item.step;
                return (
                  <div class:list={[
                    'flex items-center gap-2',
                    complete || current ? 'font-semibold text-white' : 'text-[#7897b8]'
                  ]}>
                    <span class:list={[
                      'flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[0.65rem]',
                      complete ? 'bg-[#73d7ff] text-[#0a2850]' : current ? 'border border-[#73d7ff] text-[#73d7ff]' : 'border border-white/25'
                    ]}>
                      {complete ? <Icon name="check" size={13} /> : item.step}
                    </span>
                    {item.label}
                  </div>
                );
              })}
            </div>
          </div>

          <a href={`/requests/${ticket.ticketId}`} class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-[#83ddff] transition hover:text-white">
            View request details
            <Icon name="arrow" size={17} />
          </a>
        </article>

        <article class="flex flex-col justify-between rounded-2xl border border-[#d9e5ee] bg-white p-6 shadow-[0_12px_30px_rgba(16,40,69,0.04)] sm:p-7">
          <div>
            <div class="flex items-center justify-between">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#fff5dc] text-[#b47a11]"><Icon name="message" size={20} /></span>
              <span class="rounded-full bg-[#fff5dc] px-2.5 py-1 text-[0.65rem] font-bold uppercase tracking-[0.12em] text-[#94640c]">Your action</span>
            </div>
            <p class="mt-6 text-xs font-bold uppercase tracking-[0.16em] text-[#54708e]">Next step</p>
            <h2 class="mt-2 text-xl font-semibold tracking-[-0.025em] text-[#102845]">{statusStep === 3 ? 'Review the resolution' : 'Confirm a convenient time'}</h2>
            <p class="mt-3 text-sm leading-6 text-[#607a95]">{statusStep === 3 ? 'Your service update is ready. Open the request to review what happens next.' : 'We are ready for the next check. Reply with a preferred time for the remote session.'}</p>
          </div>
          <div class="mt-7">
            <a href="/messages" class="inline-flex items-center gap-2 text-sm font-bold text-[#1267a8] transition hover:text-[#0a416b]">
              Reply to technician
              <Icon name="arrow" size={17} />
            </a>
            <p class="mt-4 flex items-center gap-2 text-xs text-[#748aa0]"><Icon name="clock" size={14} /> Usually replies within one business day</p>
          </div>
        </article>
      </section>
    ) : (
      <section class="grid gap-5 xl:grid-cols-[minmax(0,1.7fr)_minmax(300px,0.9fr)]" aria-label="Welcome to your portal">
        <article class="relative isolate overflow-hidden rounded-2xl bg-[#0a2850] p-6 text-white shadow-[0_18px_40px_rgba(10,40,80,0.12)] sm:p-8">
          <div class="pointer-events-none absolute -right-16 -top-28 -z-10 h-72 w-72 rounded-full bg-[#1b6da9]/35 blur-3xl"></div>
          <div class="pointer-events-none absolute bottom-[-7rem] right-24 -z-10 h-56 w-56 rounded-full bg-[#f3bf58]/15 blur-3xl"></div>
          <div class="max-w-xl">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#12416f] text-[#73d7ff]"><Icon name="shield" size={22} /></span>
            <p class="mt-6 text-xs font-bold uppercase tracking-[0.16em] text-[#83ddff]">Welcome to your workspace</p>
            <h2 class="mt-3 max-w-lg text-2xl font-semibold tracking-[-0.03em] sm:text-[1.75rem]">You have no active service tickets.</h2>
            <p class="mt-3 max-w-lg text-sm leading-6 text-[#b9cee3]">When something is not working or you are ready to build, we will help you identify the most practical next step.</p>
            <a href="/requests/new" class="mt-7 inline-flex items-center justify-center gap-2 rounded-xl bg-[#f3bf58] px-4 py-3 text-sm font-bold text-[#102845] shadow-[0_8px_20px_rgba(0,0,0,0.12)] transition hover:-translate-y-0.5 hover:bg-[#ffd477] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f3bf58] focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a2850]">
              <Icon name="plus" size={18} />
              Request a New Service
            </a>
          </div>
        </article>

        <article class="flex flex-col justify-between rounded-2xl border border-[#d9e5ee] bg-white p-6 shadow-[0_12px_30px_rgba(16,40,69,0.04)] sm:p-7">
          <div>
            <div class="flex items-center justify-between">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#e9f7f0] text-[#21875c]"><Icon name="check" size={20} /></span>
              <span class="rounded-full bg-[#e9f7f0] px-2.5 py-1 text-[0.65rem] font-bold uppercase tracking-[0.12em] text-[#287650]">Ready when you are</span>
            </div>
            <p class="mt-6 text-xs font-bold uppercase tracking-[0.16em] text-[#54708e]">A clear process</p>
            <h2 class="mt-2 text-xl font-semibold tracking-[-0.025em] text-[#102845]">Tell us what you need.</h2>
            <p class="mt-3 text-sm leading-6 text-[#607a95]">Share a few details and we will come back with an honest assessment and clear next steps.</p>
          </div>
          <a href="/requests/new" class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-[#1267a8] transition hover:text-[#0a416b]">Start a request <Icon name="arrow" size={17} /></a>
        </article>
      </section>
    )}

    <section class="grid gap-4 md:grid-cols-3" aria-label="Portal summary">
      {metrics.map((metric) => (
        <article class="rounded-2xl border border-[#d9e5ee] bg-white p-5 shadow-[0_12px_30px_rgba(16,40,69,0.035)] sm:p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-semibold text-[#6a8198]">{metric.label}</p>
              <p class="mt-3 text-2xl font-semibold tracking-[-0.04em] text-[#102845]">{metric.value}</p>
            </div>
            <span class:list={[
              'flex h-10 w-10 items-center justify-center rounded-xl',
              metric.tone === 'green' && 'bg-[#e9f7f0] text-[#21875c]',
              metric.tone === 'gold' && 'bg-[#fff5dc] text-[#b47a11]',
              metric.tone === 'blue' && 'bg-[#e7f4fb] text-[#1267a8]'
            ]}>
              <Icon name={metric.icon} size={19} />
            </span>
          </div>
          <p class="mt-4 text-xs font-medium text-[#607a95]">{metric.detail}</p>
        </article>
      ))}
    </section>

    <section class="grid items-start gap-5 xl:grid-cols-[minmax(0,1.35fr)_minmax(320px,0.85fr)]">
      <article class="overflow-hidden rounded-2xl border border-[#d9e5ee] bg-white shadow-[0_12px_30px_rgba(16,40,69,0.035)]">
        <div class="flex items-center justify-between border-b border-[#e5edf3] px-5 py-5 sm:px-7">
          <div>
            <p class="eyebrow">Keep informed</p>
            <h2 class="mt-1.5 text-lg font-semibold tracking-[-0.025em] text-[#102845]">Recent activity</h2>
          </div>
          <a href="/activity" class="text-xs font-bold text-[#1267a8] transition hover:text-[#0a416b]">See all</a>
        </div>
        <div class="divide-y divide-[#e8eef3] px-5 sm:px-7">
          {activity.length > 0 ? activity.map((item) => (
            <div class="flex gap-4 py-5">
              <span class:list={[
                'mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full',
                item.color === 'blue' && 'bg-[#e7f4fb] text-[#1267a8]',
                item.color === 'green' && 'bg-[#e9f7f0] text-[#21875c]',
                item.color === 'gold' && 'bg-[#fff5dc] text-[#b47a11]'
              ]}>
                <Icon name={item.icon} size={17} />
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-col justify-between gap-1 sm:flex-row sm:gap-4">
                  <p class="text-sm font-semibold text-[#203c59]">{item.title}</p>
                  <time class="shrink-0 text-xs text-[#8a9caf]">{item.date}</time>
                </div>
                <p class="mt-1 text-xs leading-5 text-[#6b829a]">{item.detail}</p>
              </div>
            </div>
          )) : (
            <p class="py-7 text-sm leading-6 text-[#6b829a]">No recent ticket activity. Request a service whenever you are ready.</p>
          )}
        </div>
      </article>

      <article class="rounded-2xl border border-[#d9e5ee] bg-white p-5 shadow-[0_12px_30px_rgba(16,40,69,0.035)] sm:p-7">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="eyebrow">Need something else?</p>
            <h2 class="mt-1.5 text-lg font-semibold tracking-[-0.025em] text-[#102845]">Start with clarity</h2>
          </div>
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#eef5f9] text-[#1267a8]"><Icon name="sparkle" size={18} /></span>
        </div>
        <p class="mt-4 text-sm leading-6 text-[#607a95]">Tell us what is not working, what you want to build or the decision you need to clarify.</p>
        <div class="mt-6 space-y-2">
          <a href="/requests/new" class="flex items-center justify-between rounded-xl border border-[#d9e5ee] px-4 py-3 text-sm font-semibold text-[#203c59] transition hover:border-[#90c9e3] hover:bg-[#f4fbfe]">
            <span class="flex items-center gap-3"><Icon name="plus" size={17} class="text-[#1267a8]" /> Request a service</span>
            <Icon name="arrow" size={16} class="text-[#88a0b5]" />
          </a>
          <a href="https://wa.me/233550621987" class="flex items-center justify-between rounded-xl border border-[#d9e5ee] px-4 py-3 text-sm font-semibold text-[#203c59] transition hover:border-[#90c9e3] hover:bg-[#f4fbfe]">
            <span class="flex items-center gap-3"><Icon name="phone" size={17} class="text-[#21875c]" /> Chat on WhatsApp</span>
            <Icon name="external" size={15} class="text-[#88a0b5]" />
          </a>
        </div>
        <div class="mt-6 flex items-start gap-3 border-t border-[#e5edf3] pt-5">
          <Icon name="shield" size={17} class="mt-0.5 shrink-0 text-[#1267a8]" />
          <p class="text-xs leading-5 text-[#6b829a]">You will receive a clear scope and quotation before major work begins.</p>
        </div>
      </article>
    </section>

    <section>
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">E Light Services</p>
          <h2 class="mt-1.5 text-lg font-semibold tracking-[-0.025em] text-[#102845]">What can we help with?</h2>
        </div>
        <a href="/services" class="hidden items-center gap-1.5 text-xs font-bold text-[#1267a8] transition hover:text-[#0a416b] sm:flex">Explore services <Icon name="arrow" size={15} /></a>
      </div>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        {services.map((service) => (
          <a href="/requests/new" class="group rounded-2xl border border-[#d9e5ee] bg-white p-4 transition hover:-translate-y-0.5 hover:border-[#91cce5] hover:shadow-[0_12px_26px_rgba(16,40,69,0.06)] sm:p-5">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#eef5f9] text-[#1267a8] transition group-hover:bg-[#1267a8] group-hover:text-white"><Icon name={service.icon} size={19} /></span>
            <p class="mt-4 text-sm font-bold text-[#203c59]">{service.label}</p>
            <p class="mt-1 text-xs leading-5 text-[#71869a]">{service.detail}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
