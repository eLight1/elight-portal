---
import AuthLayout from '../layouts/AuthLayout.astro';
import { safeReturnTo, USER_SESSION_KEY } from '../lib/auth';

export const prerender = false;

const existingUser = await Astro.session?.get(USER_SESSION_KEY);
const returnTo = safeReturnTo(Astro.url.searchParams.get('next'));

if (existingUser) {
  return Astro.redirect(returnTo);
}

const errorCode = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  config: 'Google sign-in is not configured yet. Add the OAuth credentials to the Worker environment.',
  denied: 'Sign-in was cancelled. You can try again whenever you are ready.',
  state: 'Your sign-in request expired or could not be verified. Please try again.',
  oauth: 'Google could not complete the sign-in. Please try again.',
  profile: 'We could not verify the Google profile returned for this account.',
  network: 'Google could not be reached. Check your connection and try again.'
};
const errorMessage = errorCode ? errorMessages[errorCode] || errorMessages.oauth : null;
const signedOut = Astro.url.searchParams.get('logged_out') === '1';
---

<AuthLayout title="Sign in | E Light Services">
  <div class="mt-10 lg:mt-0">
    <div class="text-center lg:text-left">
      <p class="eyebrow">Welcome back</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-[#102845] sm:text-4xl">Sign in to your portal.</h1>
      <p class="mx-auto mt-4 max-w-md text-sm leading-6 text-[#607a95] lg:mx-0">Access your service requests, updates and clear next steps in one secure workspace.</p>
    </div>

    {errorMessage && (
      <div class="mt-8 flex gap-3 rounded-xl border border-[#f0caca] bg-[#fff7f7] p-4 text-sm text-[#9b3c3c]" role="alert">
        <span class="mt-0.5 shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" /></svg></span>
        <p>{errorMessage}</p>
      </div>
    )}

    {signedOut && (
      <div class="mt-8 flex gap-3 rounded-xl border border-[#c9ead9] bg-[#f2fbf6] p-4 text-sm text-[#287650]" role="status">
        <span class="mt-0.5 shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></span>
        <p>You have been signed out securely.</p>
      </div>
    )}

    <div class="mt-9 rounded-2xl border border-[#d9e5ee] bg-white p-5 shadow-[0_18px_42px_rgba(16,40,69,0.06)] sm:p-7">
      <a
        href={`/api/auth/google?next=${encodeURIComponent(returnTo)}`}
        class="flex w-full items-center justify-center gap-3 rounded-xl border border-[#cddbe6] bg-white px-4 py-3.5 text-sm font-bold text-[#203c59] shadow-sm transition hover:border-[#8ec8e4] hover:bg-[#f7fbfd] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1267a8] focus-visible:ring-offset-2"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M21.35 12.23c0-.72-.06-1.42-.18-2.09H12v3.96h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.26Z" />
          <path fill="#34A853" d="M12 21.5c2.63 0 4.84-.87 6.45-2.36l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.3v2.53A9.75 9.75 0 0 0 12 21.5Z" />
          <path fill="#FBBC05" d="M6.54 13.58a5.86 5.86 0 0 1 0-3.16V7.89H3.3a9.75 9.75 0 0 0 0 8.22l3.24-2.53Z" />
          <path fill="#EA4335" d="M12 6.39c1.43 0 2.71.49 3.72 1.46l2.79-2.79C16.84 3.48 14.63 2.5 12 2.5a9.75 9.75 0 0 0-8.7 5.39l3.24 2.53C7.31 8.11 9.46 6.39 12 6.39Z" />
        </svg>
        Sign in with Google
      </a>
      <div class="mt-6 flex items-center gap-3 text-xs text-[#8a9caf]">
        <span class="h-px flex-1 bg-[#e5edf3]"></span>
        <span>Secure access</span>
        <span class="h-px flex-1 bg-[#e5edf3]"></span>
      </div>
      <p class="mt-5 flex items-start gap-2.5 text-xs leading-5 text-[#6b829a]">
        <svg class="mt-0.5 shrink-0 text-[#1267a8]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10V7a5 5 0 0 1 10 0v3M5 10h14v10H5V10ZM12 14v2" /></svg>
        We use Google only to verify your identity. Your portal session is stored server-side and we never store your Google password.
      </p>
    </div>

    <p class="mt-7 text-center text-xs leading-5 text-[#8094a8] lg:text-left">Need help accessing your account? <a href="https://wa.me/233550621987" class="font-bold text-[#1267a8] hover:text-[#0a416b]">Message E Light Services</a>.</p>
  </div>
</AuthLayout>
